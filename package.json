{
  "name": "til-journal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @til/web dev",
    "build": "pnpm --filter @til/web build",
    "preview": "pnpm --filter @til/web preview",
    "lint": "pnpm lint:notes",
    "lint:notes": "node libs/journal/lint.js",
    "index:notes": "node libs/journal/update-readme.js",
    "new": "node libs/journal/new.js"
  }
}
