---
import '../styles/site.css';
import { repository, sitePath } from '../lib/paths';
const { title, description = '오늘 배운 것을 모아 읽는 성장 다이어리', current } = Astro.props;
---
<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#f8f8fc" />
  <meta name="description" content={description} />
  <title>{title ? title + ' · TIL' : 'TIL'}</title>
</head>
<body>
  <a class="skip-link" href="#main">본문으로 건너뛰기</a>
  <header class="topbar"><div class="inner topbar-inner">
    <a class="brand" href={sitePath()}><span class="brand-mark">TIL</span> 공부 일지</a>
    <nav aria-label="주 메뉴">
      <a href={sitePath()} aria-current={current === 'records' ? 'page' : undefined}>기록</a>
      <a id="growth" href={sitePath('growth/')} aria-current={current === 'growth' ? 'page' : undefined}>학습 현황</a>
      {import.meta.env.DEV && <a href={sitePath("write/")} aria-current={current === "write" ? "page" : undefined}>글쓰기</a>}
      <a class="source" href={repository}>GitHub <span aria-hidden="true">↗</span></a>
    </nav>
  </div></header>
  <main id="main" class="inner"><slot /></main>
</body>
</html>
