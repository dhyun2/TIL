---
const { note } = Astro.props;
---
<div class="note-row-meta">
  <time datetime={note.day}>{note.day.slice(5).replace('-', '.')}</time>
  {note.example && <span class="example-label">예시</span>}
</div>
<div class="note-row-copy"><h4 class="note-row-title">{note.title}</h4><p>{note.summary}</p></div>
